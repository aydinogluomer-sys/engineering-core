{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "engineering-core cross-model report v3",
  "type": "object",
  "required": [
    "schema_version", "commit_sha", "dataset_version", "dataset_hash", "claude_code_version",
    "os", "requested_model", "effective_model", "effective_model_observed", "fallback_detected",
    "fallback_reason", "evaluation_type", "scope", "selected_scenario_ids", "expected_scenario_ids",
    "evaluation_completed", "quality_gate_passed", "gate_reasons", "results"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dataset_version": {"type": "string", "minLength": 1},
    "dataset_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claude_code_version": {"type": "string", "minLength": 1},
    "os": {"type": "string", "minLength": 1},
    "requested_model": {"enum": ["haiku", "sonnet", "opus", "fable"]},
    "effective_model": {"type": "string", "minLength": 1},
    "effective_model_observed": {"type": "boolean"},
    "fallback_detected": {"enum": [true, false, "unknown"]},
    "fallback_reason": {"type": ["string", "null"]},
    "evaluation_type": {"enum": ["activation", "mode_selection", "core", "team"]},
    "scope": {"enum": ["complete", "partial"]},
    "selected_scenario_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "expected_scenario_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evaluation_completed": {"type": "boolean"},
    "quality_gate_passed": {"type": ["boolean", "null"]},
    "gate_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scenario_id", "status", "activation_tier", "selected_mode", "expected_mode",
          "reserved_cost_usd", "cost_usd", "accounted_cost_usd", "elapsed_seconds", "failure_class",
          "evidence", "limitations", "requested_model", "effective_model", "effective_model_observed",
          "fallback_detected", "fallback_reason"
        ],
        "properties": {
          "scenario_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
          "activation_tier": {"enum": ["A", "B", "C", null]},
          "selected_mode": {"type": ["string", "null"]},
          "expected_mode": {"type": ["string", "null"]},
          "reserved_cost_usd": {"type": "number", "minimum": 0},
          "cost_usd": {"type": ["number", "null"], "minimum": 0},
          "accounted_cost_usd": {"type": "number", "minimum": 0},
          "elapsed_seconds": {"type": "number", "minimum": 0},
          "failure_class": {"type": ["string", "null"]},
          "evidence": {"type": "object"},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "requested_model": {"enum": ["haiku", "sonnet", "opus", "fable"]},
          "effective_model": {"type": "string", "minLength": 1},
          "effective_model_observed": {"type": "boolean"},
          "fallback_detected": {"enum": [true, false, "unknown"]},
          "fallback_reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}
